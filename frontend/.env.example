# PackCheck AI - Frontend Production Environment Configuration for Vercel
# ========================================================================
# Set these in your Vercel Project Settings -> Environment Variables

# 1. Backend Gateway Base URL:
# For production connected to your deployed backend (e.g. on Render, Railway, AWS, or VPS):
# Example: VITE_API_BASE_URL=https://api.packcheck.ai/api/v1
# Default if self-hosted or testing locally:
VITE_API_BASE_URL=http://localhost:5000/api/v1

# 2. Demo Mode:
# Set to 'false' when connected to live backend.
# If backend is not deployed yet or for public client previews, set to 'true' to use client-side demo inspection.
VITE_DEMO_MODE=false

# 3. Environment:
VITE_APP_ENV=production

# 4. Request Timeout:
VITE_API_TIMEOUT_MS=60000
