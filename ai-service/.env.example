# AI Service (Python/FastAPI) environment variables
# Copy this file to .env and fill in real values. Never commit the real .env.

PORT=8000

# Allowed origin for CORS (this service is called by the Node backend only)
BACKEND_ORIGIN=http://localhost:5000

# OCR engine selection: "paddleocr" or "tesseract"
OCR_ENGINE=paddleocr

# Path to tesseract binary, only needed if OCR_ENGINE=tesseract and it's not on PATH
TESSERACT_CMD=/usr/bin/tesseract

# Minimum OCR confidence to accept a text block (0.0 - 1.0)
MIN_OCR_CONFIDENCE=0.5
