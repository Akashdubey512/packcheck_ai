# AI Service Environment Variables
# Copy to .env for local runtime customization. Never commit the actual .env.

PORT=8000
HOST=127.0.0.1
BACKEND_ORIGIN=http://localhost:5000

# OCR Engine Configuration
OCR_ENGINE=rapidocr
TESSERACT_CMD=tesseract
MIN_OCR_CONFIDENCE=0.5

# Inspection Session & Cache Paths
SESSIONS_DIR=processed_data/sessions
REPORTS_DIR=reports/pdf_exports
