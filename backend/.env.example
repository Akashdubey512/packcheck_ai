# Backend (Node/Express) environment variables
# Copy this file to .env and fill in real values. Never commit the real .env.

PORT=5000

# MongoDB connection string (local or Atlas)
MONGO_URI=mongodb://localhost:27017/legal-metrology-checker

# JWT
JWT_SECRET=replace-with-a-long-random-string
JWT_EXPIRES_IN=7d

# URL of the Python AI microservice
AI_SERVICE_URL=http://localhost:8000

# Allowed frontend origin for CORS
FRONTEND_ORIGIN=http://localhost:5173

# Where uploaded images are stored (local disk for hackathon; swap for S3/Cloudinary later)
UPLOAD_DIR=./uploads
